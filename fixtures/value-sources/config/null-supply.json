{
  "why": "config の JSON null は provider 境界の『供給なし』としてラダーを通過する (DR-050 §4 / DR-130 §9.1)。これは成功 result の値空間で値なしを表す `null` とは別位相で、config null 自体が値として流入するわけではない。下位 default があればその値へ、無ければ結果射影で `null` 座になる。config_file 要素はインフラ要素なので結果キーを占有しない。",
  "query": "parse",
  "definition": {
    "options": [
      {
        "name": "config",
        "type": "config_file",
        "long": true,
        "default": "/app.toml"
      },
      {
        "name": "port",
        "type": "number",
        "long": true,
        "config_key": [
          "port"
        ],
        "default": 9
      },
      {
        "name": "name",
        "type": "string",
        "long": true,
        "config_key": [
          "name"
        ]
      }
    ]
  },
  "cases": [
    {
      "id": "null-passes-through",
      "why": "config `{port:null,name:null}` は両席とも供給なし。port は下位 default 9、name は値源が枯渇して結果 / sources とも `null`。provider 境界の null と結果値の null が異なる位相であることを固定する。",
      "args": [],
      "config": {
        "port": null,
        "name": null
      },
      "expect": {
        "outcome": "success",
        "effects": [],
        "result": {
          "port": 9,
          "name": null
        },
        "sources": {
          "port": "default",
          "name": null
        }
      }
    },
    {
      "id": "real-value-supplied",
      "why": "実値 port=3000 は config から供給される。name は config にキーがなく値源も無いため、全列挙された結果 / sources の座が `null` になる。",
      "args": [],
      "config": {
        "port": 3000
      },
      "expect": {
        "outcome": "success",
        "effects": [],
        "result": {
          "port": 3000,
          "name": null
        },
        "sources": {
          "port": "config",
          "name": null
        }
      }
    }
  ]
}
